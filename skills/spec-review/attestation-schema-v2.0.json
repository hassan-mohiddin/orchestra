{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "orchestra Spec Review Attestation v2.0",
  "type": "object",
  "required": [
    "schema_version",
    "doc_subject",
    "peer_judge",
    "sub_judges",
    "findings_aggregated",
    "overall_verdict",
    "overall_verdict_basis",
    "attestation_integrity_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "doc_subject": {
      "type": "object",
      "required": [
        "path",
        "content_hash",
        "iter_commit_sha",
        "iter_blob_sha",
        "iteration"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/(features|bugs|adr|design|postmortems|runbooks|plans|archive/[a-z]+)/.+\\.md$"
        },
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "iter_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$|^<uncommitted>$"
        },
        "iter_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "iteration": {"type": "integer", "minimum": 1}
      }
    },
    "peer_judge": {
      "type": "object",
      "required": ["id", "invoked_at", "context_isolation"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "invoked_at": {"type": "string", "format": "date-time"},
        "context_isolation": {"const": "fresh_subagent_per_subjudge"}
      }
    },
    "sub_judges": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/sub_judge"}
    },
    "findings_aggregated": {
      "type": "array",
      "items": {"$ref": "#/definitions/finding"}
    },
    "overall_verdict": {"enum": ["pass", "conditional_pass", "fail"]},
    "overall_verdict_basis": {
      "type": "object",
      "required": [
        "worst_sub_judge_verdict",
        "excluded_sub_judges",
        "mandatory_failures",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "worst_sub_judge_verdict": {
          "enum": ["pass", "conditional_pass", "fail"]
        },
        "excluded_sub_judges": {
          "type": "array",
          "items": {"type": "string"}
        },
        "mandatory_failures": {
          "type": "array",
          "items": {"type": "string"}
        },
        "reason": {"type": ["string", "null"]}
      }
    },
    "attestation_integrity_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "required_followup": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {"type": "string"}
  },
  "definitions": {
    "sub_judge": {
      "type": "object",
      "required": [
        "id",
        "model",
        "mandatory",
        "rubric_version",
        "status",
        "verdict",
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "structure",
            "semantic",
            "gate-compliance",
            "adversarial",
            "repo-context",
            "architectural-fit"
          ]
        },
        "model": {"type": "string"},
        "mandatory": {"type": "boolean"},
        "rubric_version": {"type": "string"},
        "status": {"enum": ["completed", "error", "timeout"]},
        "error_message": {"type": "string"},
        "verdict": {"enum": ["pass", "conditional_pass", "fail"]},
        "findings": {
          "type": "array",
          "items": {"$ref": "#/definitions/finding"}
        },
        "justification": {"type": "string", "minLength": 10}
      },
      "if": {
        "properties": {
          "findings": {"maxItems": 0},
          "status": {"const": "completed"}
        }
      },
      "then": {"required": ["justification"]}
    },
    "finding": {
      "type": "object",
      "required": ["severity", "location", "problem", "scope"],
      "additionalProperties": false,
      "properties": {
        "severity": {"enum": ["Critical", "Important", "Minor"]},
        "location": {
          "type": "string",
          "pattern": "^(.+\\s+§\\s+.+|line\\s+\\d+)$"
        },
        "problem": {"type": "string", "minLength": 1, "maxLength": 500},
        "scope": {"enum": ["instance", "class"]},
        "raised_by": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      }
    }
  }
}
